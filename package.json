{
  "name": "hvn-ds",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp run -r build && vp check && vp test",
    "dev": "vp run @hvn-oss/ds#build && vp run -r --parallel dev",
    "prepare": "vp config && vp run @hvn-oss/ds#build",
    "clean": "vp run -r clean && git clean -xdf node_modules"
  },
  "devDependencies": {
    "@astryxdesign/cli": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
